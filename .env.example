# Alibaba Cloud Bailian / DashScope OpenAI-compatible endpoint
# Replace this placeholder before starting the app. Never commit a real API key.
LLM_API_KEY=replace-with-your-bailian-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# SQLite persistence
DATABASE_URL=sqlite:///./fitlife.db

# Optional runtime controls
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
APP_LOG_LEVEL=INFO
